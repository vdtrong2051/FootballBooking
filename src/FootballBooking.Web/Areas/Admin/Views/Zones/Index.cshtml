@model IReadOnlyList<FootballBooking.Application.Fields.FieldZoneDto>
@{
    ViewData["Title"] = "Quản lý phân khu";
}
<div class="space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold text-ink">Phân khu sân bóng</h1>
        <a href="/admin/fields" class="fb-button fb-button-secondary">Danh sách sân</a>
    </div>
    @if (TempData["SuccessMessage"] is string success)
    { <p class="rounded-lg bg-green-50 p-3 text-green-800">@success</p> }
    @if (TempData["ErrorMessage"] is string error)
    { <p class="rounded-lg bg-red-50 p-3 text-red-800">@error</p> }
    <section class="fb-card p-4">
        <h2 class="font-semibold">Thêm phân khu</h2>
        <form method="post" action="/admin/zones/save" class="mt-3 grid gap-3 sm:grid-cols-2">
            @Html.AntiForgeryToken()
            <div><label class="fb-label">Mã khu</label><input class="fb-input" name="Code" maxlength="20" required placeholder="A" /></div>
            <div><label class="fb-label">Tên khu</label><input class="fb-input" name="Name" maxlength="100" required placeholder="Khu A" /></div>
            <div><label class="fb-label">Mô tả</label><input class="fb-input" name="Description" maxlength="500" /></div>
            <div><label class="fb-label">Thứ tự</label><input class="fb-input" name="SortOrder" type="number" min="0" max="10000" value="0" /></div>
            <input type="hidden" name="IsActive" value="true" />
            <button class="fb-button fb-button-primary sm:col-span-2" type="submit">Thêm khu</button>
        </form>
    </section>
    @foreach (var zone in Model)
    {
        <section class="fb-card p-4">
            <form method="post" action="/admin/zones/save" class="grid gap-3 sm:grid-cols-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@zone.Id" />
                <input type="hidden" name="IsActive" value="@(zone.IsActive ? "true" : "false")" />
                <div><label class="fb-label">Mã khu</label><input class="fb-input" name="Code" value="@zone.Code" required maxlength="20" /></div>
                <div><label class="fb-label">Tên khu</label><input class="fb-input" name="Name" value="@zone.Name" required maxlength="100" /></div>
                <div><label class="fb-label">Mô tả</label><input class="fb-input" name="Description" value="@zone.Description" maxlength="500" /></div>
                <div><label class="fb-label">Thứ tự</label><input class="fb-input" name="SortOrder" type="number" min="0" max="10000" value="@zone.SortOrder" /></div>
                <p class="text-sm text-muted sm:col-span-3">
                    @zone.TotalFields sân · @zone.ActiveFields sân đang hoạt động · @(zone.IsActive ? "Đang nhận đặt" : "Ngừng nhận đặt mới")
                </p>
                <button class="fb-button fb-button-secondary" type="submit">Lưu thay đổi</button>
            </form>
            <form method="post" action="/admin/zones/@zone.Id/active" class="mt-2">
                @Html.AntiForgeryToken()
                <input name="enabled" type="hidden" value="@(zone.IsActive ? "false" : "true")" />
                <button class="fb-button fb-button-secondary" type="submit">@(zone.IsActive ? "Ngừng nhận đặt tại khu" : "Mở nhận đặt tại khu")</button>
            </form>
        </section>
    }
    @if (Model.Count == 0) { <p class="text-sm text-muted">Chưa có phân khu. Hãy tạo khu A/B rồi gán sân.</p> }
</div>
