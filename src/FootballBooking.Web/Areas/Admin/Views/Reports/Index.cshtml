@model AdminReportsViewModel
@{
    ViewData["Title"] = "Báo cáo";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItemViewModel>
    {
        new("Quản trị", "/admin/dashboard"),
        new("Báo cáo")
    };

    var fromIso = Model.FromDate.ToString("yyyy-MM-dd");
    var toIso = Model.ToDate.ToString("yyyy-MM-dd");
    var previousFromIso = Model.FromDate.AddDays(-7).ToString("yyyy-MM-dd");
    var previousToIso = Model.ToDate.AddDays(-7).ToString("yyyy-MM-dd");
    var nextFromIso = Model.FromDate.AddDays(7).ToString("yyyy-MM-dd");
    var nextToIso = Model.ToDate.AddDays(7).ToString("yyyy-MM-dd");
    var monthFromIso = new DateOnly(Model.ToDate.Year, Model.ToDate.Month, 1).ToString("yyyy-MM-dd");
    var monthToIso = new DateOnly(Model.ToDate.Year, Model.ToDate.Month, DateTime.DaysInMonth(Model.ToDate.Year, Model.ToDate.Month)).ToString("yyyy-MM-dd");
}

<div class="fb4c-reports space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Phân tích tài chính &amp; vận hành</p>
            <h1 class="mt-1 text-2xl font-semibold text-ink">Báo cáo thác nước doanh thu</h1>
            <p class="mt-1 text-sm text-muted">Theo dõi biến động thác nước doanh thu, cầu nối tài chính, tỷ lệ lấp đầy và công nợ trong kỳ.</p>
        </div>
        <a class="fb-button fb-button-primary" href="/admin/reports/revenue.csv?from=@fromIso&to=@toIso">Xuất CSV</a>
    </div>

    <form class="fb4c-filter-panel fb-card grid gap-4 p-4 sm:grid-cols-[1fr_1fr_auto]" method="get" action="/admin/reports">
        <div>
            <label class="fb-label" for="from">Từ ngày</label>
            <input class="fb-input" id="from" name="from" type="date" value="@fromIso" />
        </div>
        <div>
            <label class="fb-label" for="to">Đến ngày</label>
            <input class="fb-input" id="to" name="to" type="date" value="@toIso" />
        </div>
        <div class="flex items-end">
            <button class="fb-button fb-button-secondary w-full justify-center" type="submit">Lọc báo cáo</button>
        </div>
    </form>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center gap-3">
            <p class="text-sm font-medium text-ink">Kỳ đang xem: @Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")</p>
            <span class="rounded-ui border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-800">Tăng (+)</span>
            <span class="rounded-ui border border-red-200 bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700">Giảm / Khuyến mãi / Hoàn (-)</span>
            <span class="rounded-ui border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-800">Cột Tổng kết (=)</span>
        </div>
        <div class="flex flex-wrap gap-2">
            <a class="fb-button fb-button-secondary" href="/admin/reports?from=@previousFromIso&to=@previousToIso">Tuần trước</a>
            <a class="fb-button fb-button-secondary" href="/admin/reports?from=@nextFromIso&to=@nextToIso">Tuần sau</a>
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        @foreach (var metric in Model.Metrics)
        {
            <partial name="~/Areas/Admin/Views/Dashboard/_MetricCard.cshtml" model="metric" />
        }
    </div>

    <div class="grid gap-5 xl:grid-cols-2">
        <section class="fb-card min-w-0 p-4">
            <div>
                <h2 class="font-semibold text-ink">Biểu đồ thác nước cơ cấu doanh thu</h2>
                <p class="text-sm text-muted">Cầu nối tài chính: Tiền sân + Dịch vụ - Khuyến mãi + Phí hủy - Hoàn trả - Công nợ = Thực thu ròng.</p>
            </div>
            <div class="mt-4 h-72 min-w-0">
                <canvas data-report-chart data-chart-url="/admin/api/dashboard/revenue-waterfall?from=@fromIso&to=@toIso" aria-label="Biểu đồ thác nước cơ cấu doanh thu"></canvas>
            </div>
            <p class="mt-3 hidden rounded-ui border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" data-chart-error>Không tải được biểu đồ thác nước cơ cấu doanh thu.</p>
        </section>

        <section class="fb-card min-w-0 p-4">
            <div>
                <h2 class="font-semibold text-ink">Biểu đồ thác nước lũy kế doanh thu theo ngày</h2>
                <p class="text-sm text-muted">Biến động cộng dồn từng ngày trong kỳ đến tổng thực thu cuối kỳ.</p>
            </div>
            <div class="mt-4 h-72 min-w-0">
                <canvas data-report-chart data-chart-url="/admin/api/dashboard/revenue?from=@fromIso&to=@toIso" aria-label="Biểu đồ thác nước doanh thu theo ngày"></canvas>
            </div>
            <p class="mt-3 hidden rounded-ui border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" data-chart-error>Không tải được biểu đồ doanh thu.</p>
        </section>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
        <section class="fb-card min-w-0 p-4">
            <div>
                <h2 class="font-semibold text-ink">Thác nước doanh thu trong tháng (@Model.ToDate.ToString("MM/yyyy"))</h2>
                <p class="text-sm text-muted">Cộng dồn các ngày phát sinh doanh thu trong tháng đang chọn.</p>
            </div>
            <div class="mt-4 h-60 min-w-0">
                <canvas data-report-chart data-chart-url="/admin/api/dashboard/revenue?from=@monthFromIso&to=@monthToIso" aria-label="Biểu đồ thác nước doanh thu tháng"></canvas>
            </div>
            <p class="mt-3 hidden rounded-ui border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" data-chart-error>Không tải được biểu đồ doanh thu tháng.</p>
        </section>

        <section class="fb-card min-w-0 p-4">
            <div>
                <h2 class="font-semibold text-ink">Lượt đặt sân theo ngày</h2>
                <p class="text-sm text-muted">Không tính lượt đã hủy, hết hạn hoặc khách không đến.</p>
            </div>
            <div class="mt-4 h-60 min-w-0">
                <canvas data-report-chart data-chart-url="/admin/api/dashboard/bookings?from=@fromIso&to=@toIso" aria-label="Biểu đồ lượt đặt sân theo ngày"></canvas>
            </div>
            <p class="mt-3 hidden rounded-ui border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" data-chart-error>Không tải được biểu đồ lượt đặt sân.</p>
        </section>
    </div>

    <div class="grid gap-5 xl:grid-cols-[1fr_1fr]">
        <section class="fb-card min-w-0 overflow-hidden">
            <div class="border-b border-line px-4 py-3">
                <h2 class="font-semibold text-ink">Tỷ lệ lấp đầy theo sân</h2>
                <p class="text-sm text-muted">So sánh số phút sử dụng với giờ mở cửa.</p>
            </div>
            <div class="overflow-x-auto">
                <table class="fb-table">
                    <thead>
                        <tr>
                            <th>Sân</th>
                            <th>Đã sử dụng</th>
                            <th>Giờ mở cửa</th>
                            <th>Tỷ lệ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line bg-white">
                        @foreach (var item in Model.FieldUtilization)
                        {
                            <tr>
                                <td class="font-medium">@item.FieldName</td>
                                <td>@FormatHours(item.UsedMinutes)</td>
                                <td>@FormatHours(item.AvailableMinutes)</td>
                                <td class="font-semibold text-ink">@item.UtilizationPercent.ToString("0.#")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="fb-card min-w-0 overflow-hidden">
            <div class="border-b border-line px-4 py-3">
                <h2 class="font-semibold text-ink">Công nợ cần xử lý</h2>
                <p class="text-sm text-muted">Các lượt đặt sân còn số tiền cần thu.</p>
            </div>
            <partial name="~/Areas/Admin/Views/Dashboard/_ReportBookingTable.cshtml" model="Model.PaymentsDue" />
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-reports.js" asp-append-version="true"></script>
}

@functions {
    private static string FormatHours(int minutes) => $"{minutes / 60m:0.#} giờ";
}
