@model FootballBooking.Application.Reports.SummaryMetricDto
<section class="fb4c-metric fb-card" data-tone="@Model.Tone">
    <div class="fb4c-metric-heading">
        <p class="text-sm font-medium text-muted">@Model.Label</p>
        <span class="fb4c-metric-mark" aria-hidden="true"></span>
    </div>
    <p class="fb4c-metric-value text-2xl font-bold text-ink">@Model.Value</p>
    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <p class="fb4c-metric-note text-xs text-muted">@Model.Note</p>
    }
</section>
