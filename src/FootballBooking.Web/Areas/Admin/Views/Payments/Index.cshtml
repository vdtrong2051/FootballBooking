@model PaymentListViewModel
@{
    ViewData["Title"] = "Thanh toán";
}
@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
    private static string FormatMinute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
}

<section class="fb4c-payment-panel fb-card p-4">
    <h1 class="text-xl font-semibold text-ink">Thanh toán</h1>
    <p class="mt-1 text-sm text-muted">Theo dõi các lượt đặt sân còn cần ghi nhận cọc hoặc thu thêm tại sân.</p>
    <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
            <thead class="border-b border-line text-xs uppercase text-muted">
                <tr>
                    <th class="py-2 pr-3">Mã đặt sân</th>
                    <th class="py-2 pr-3">Khách hàng</th>
                    <th class="py-2 pr-3">Sân</th>
                    <th class="py-2 pr-3">Ngày giờ</th>
                    <th class="py-2 pr-3">Thanh toán</th>
                    <th class="py-2 text-right">Tổng tiền</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line">
                @foreach (var booking in Model.Bookings.Take(50))
                {
                    <tr>
                        <td class="py-2 pr-3"><a class="font-medium text-brand-800 hover:text-brand-900" href="/admin/bookings/@booking.Id">@booking.BookingCode</a></td>
                        <td class="py-2 pr-3">@booking.CustomerName</td>
                        <td class="py-2 pr-3 text-muted">@booking.FieldName</td>
                        <td class="py-2 pr-3 text-muted">@booking.BookingDate.ToString("dd/MM/yyyy") · @FormatMinute(booking.StartMinute) - @FormatMinute(booking.EndMinute)</td>
                        <td class="py-2 pr-3">@BookingLabels.PaymentStatus(booking.PaymentStatus)</td>
                        <td class="py-2 text-right font-medium text-ink">@FormatMoney(booking.TotalAmount)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@{
    var gd2Attempts = ViewData["GD2Attempts"] as IReadOnlyList<FootballBooking.Application.Payments.PaymentAttemptDto>;
}
<section class="fb4c-reconciliation-panel fb-card mt-6 p-4">
    <h2 class="text-lg font-semibold text-ink">GĐ2 · Lần thử thanh toán &amp; đối soát</h2>
    <p class="mt-2 text-sm text-muted">Chỉ xác nhận sau khi kiểm tra ngân hàng/POS thực tế. QR không phải bằng chứng nhận tiền. Lần thử hết hạn hoặc sai số tiền phải đối soát riêng.</p>
    @if (TempData["ErrorMessage"] is string gd2Error)
    {
        <p class="mt-3 rounded border border-red-200 bg-red-50 p-3 text-sm">@gd2Error</p>
    }
    @if (TempData["SuccessMessage"] is string gd2Success)
    {
        <p class="mt-3 rounded border border-green-200 bg-green-50 p-3 text-sm">@gd2Success</p>
    }
    <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
            <thead><tr class="border-b border-line"><th class="py-2 pr-3">Booking</th><th class="py-2 pr-3">Phương thức</th><th class="py-2 pr-3">Số tiền</th><th class="py-2 pr-3">Trạng thái</th><th class="py-2">Xử lý</th></tr></thead>
            <tbody class="divide-y divide-line">
                @foreach (var attempt in gd2Attempts ?? Array.Empty<FootballBooking.Application.Payments.PaymentAttemptDto>())
                {
                    <tr>
                        <td class="py-3 pr-3"><a class="text-brand-800" href="/admin/bookings/@attempt.BookingId">@attempt.BookingCode</a><div class="text-xs text-muted">@attempt.RequestCode</div></td>
                        <td class="py-3 pr-3">@attempt.Method</td>
                        <td class="py-3 pr-3">@FormatMoney(attempt.Amount)</td>
                        <td class="py-3 pr-3">@attempt.Status @if (attempt.Status == FootballBooking.Domain.Payments.PaymentAttemptStatus.NeedsReconciliation) { <strong class="text-red-700">Cần xử lý thủ công</strong> }</td>
                        <td class="py-3">
                            @if (attempt.Status == FootballBooking.Domain.Payments.PaymentAttemptStatus.Pending)
                            {
                                <form method="post" action="/admin/payments/attempts/@attempt.Id/confirm" class="flex flex-col gap-2 sm:flex-row">
                                    @Html.AntiForgeryToken()
                                    <input name="externalReference" required minlength="6" maxlength="100" class="fb-input" placeholder="Mã giao dịch thực tế" />
                                    <input name="receivedAmount" required type="number" min="1" value="@attempt.Amount" class="fb-input w-36" />
                                    <button class="fb-button fb-button-primary" type="submit">Đã kiểm tra &amp; xác nhận</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-xs text-muted">@(attempt.ExternalReference ?? "—")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
