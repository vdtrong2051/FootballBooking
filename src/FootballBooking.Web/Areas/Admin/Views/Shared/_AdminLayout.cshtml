<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Sân bóng An Phú</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="fb4c-admin-body min-h-screen bg-page">
    <a class="fb4c-skip-link" href="#admin-main">Đến nội dung chính</a>
    <div class="fb4c-admin-shell flex min-h-screen">
        <partial name="Partials/_AdminSidebar" />
        <div class="fb4c-admin-workspace min-w-0 flex-1">
            <partial name="Partials/_AdminTopbar" />
            <main id="admin-main" class="fb4c-admin-content px-4 py-5 lg:px-6">
                @if (ViewData["Breadcrumbs"] is IReadOnlyList<BreadcrumbItemViewModel> breadcrumbs)
                {
                    <partial name="~/Views/Shared/Partials/_Breadcrumb.cshtml" model="breadcrumbs" />
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
