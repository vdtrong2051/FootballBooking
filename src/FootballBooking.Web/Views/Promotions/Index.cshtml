@model PromotionListViewModel
@{
    ViewData["Title"] = "Khuyến mãi";
}
@functions {
    private static string Discount(PromoCodeDto p) => p.DiscountType == PromoDiscountType.FixedAmount ? $"{p.DiscountValue:N0} ₫" : $"{p.DiscountValue / 100m:0.##}%";
}
<section class="border-b border-line bg-white"><div class="fb-container py-12 sm:py-16"><p class="fb4-kicker">Ưu đãi hiện có</p><h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Ưu đãi cho mỗi cuộc hẹn</h1><p class="fb4-lead mt-3 max-w-2xl">Nhập mã khi đặt sân để hệ thống kiểm tra điều kiện và tính mức giảm phù hợp.</p><div class="mt-7 fb4-subnav"><a href="/fields">Sân bóng</a><a href="/services">Dịch vụ</a><a href="/promotions" aria-current="page">Khuyến mãi</a></div></div></section>
<section class="fb-container fb4-section">
    @if (Model.Promotions.Count == 0) { <div class="fb4-surface p-8 text-sm text-muted">Chưa có mã khuyến mãi đang áp dụng.</div> }
    else { <div class="grid gap-5 lg:grid-cols-2">@foreach (var promo in Model.Promotions) { <article class="fb4-surface flex flex-col gap-4 p-6 sm:flex-row sm:items-start"><div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-2xl font-extrabold text-brand-800">@Discount(promo)</div><div class="min-w-0 flex-1"><p class="fb4-kicker">@promo.Code</p><h2 class="mt-2 text-lg font-bold">@promo.Name</h2><dl class="mt-3 space-y-2 text-sm text-muted"><div>Đơn tối thiểu: <strong class="text-ink">@($"{promo.MinimumOrderAmount:N0}") ₫</strong></div><div>Áp dụng: @promo.StartsAtUtc.ToString("dd/MM/yyyy") – @promo.EndsAtUtc.ToString("dd/MM/yyyy")</div></dl><a class="mt-5 inline-flex text-sm font-bold text-brand-800 hover:underline" href="/booking">Đặt sân với ưu đãi →</a></div></article> }</div> }
</section>
