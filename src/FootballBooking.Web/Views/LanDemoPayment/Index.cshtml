@model FootballBooking.Web.Controllers.LanDemoPaymentController.PageModel
@{
    ViewData["Title"] = "QR TEST LAN — xác nhận giả lập";
}
<section class="fb-container py-10">
    <div class="mx-auto max-w-lg rounded-2xl border border-amber-300 bg-white p-6 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-800">TEST MODE • Development only</p>
        <h1 class="mt-3 text-2xl font-bold text-ink">Thanh toán giả lập qua LAN</h1>
        <p class="mt-3 text-sm leading-6 text-muted">Đây là bài kiểm thử chức năng, không liên kết ngân hàng, không trừ tiền và không chuyển khoản.</p>
        <dl class="mt-5 space-y-3 rounded-xl bg-slate-50 p-4 text-sm">
            <div class="flex justify-between gap-3"><dt>Mã booking</dt><dd class="font-semibold">@Model.BookingCode</dd></div>
            <div class="flex justify-between gap-3"><dt>Số tiền giả lập</dt><dd class="font-semibold">@Model.Amount.ToString("N0") ₫</dd></div>
            <div class="break-all"><dt class="text-muted">Mã tham chiếu</dt><dd>@Model.RequestCode</dd></div>
        </dl>
        <form method="post" action="/dev/lan-pay/@Model.AttemptId" class="mt-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@Model.Token" />
            <button type="submit" class="fb-button fb-button-primary w-full">XÁC NHẬN THANH TOÁN GIẢ LẬP</button>
        </form>
        <p class="mt-3 text-xs text-amber-900">Chỉ bấm khi đang kiểm thử trong mạng riêng. Quét QR không tự thay đổi trạng thái booking.</p>
    </div>
</section>
