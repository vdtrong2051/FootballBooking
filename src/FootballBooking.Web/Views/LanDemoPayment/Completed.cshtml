@model FootballBooking.Application.Payments.PaymentAttemptDto
@{
    ViewData["Title"] = "Thanh toán giả lập thành công";
}
<section class="fb-container py-10">
    <div class="mx-auto max-w-lg rounded-2xl border border-brand-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-700">LAN DEMO • Không có tiền thật</p>
        <h1 class="mt-3 text-2xl font-bold text-ink">Đã gửi tín hiệu thanh toán giả lập</h1>
        <p class="mt-3 text-sm text-muted">Booking <strong>@Model.BookingCode</strong> đã được server xác nhận trong database demo. Quay lại trình duyệt trên máy tính và bấm “Kiểm tra trạng thái”.</p>
        <p class="mt-4 text-xs text-muted">Không có giao dịch ngân hàng, không có chứng từ chuyển khoản thật.</p>
    </div>
</section>
