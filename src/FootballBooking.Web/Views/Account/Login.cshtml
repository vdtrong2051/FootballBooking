@model CustomerLoginViewModel
@{
    ViewData["Title"] = "Đăng nhập khách hàng";
}

<section class="fb4b-auth-page fb-container py-10">
    <div class="mx-auto max-w-md fb4b-auth-card fb-card p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-800">Tài khoản khách hàng</p>
        <h1 class="mt-2 text-2xl font-semibold text-ink">Đăng nhập</h1>
        <p class="mt-2 text-sm text-muted">Đăng nhập để tự động điền thông tin khi đặt sân và theo dõi toàn bộ lịch sử đặt sân của bạn.</p>

        <form class="mt-6 space-y-4" method="post" action="/account/login">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="rounded-ui border border-red-200 bg-red-50 p-3 text-sm text-red-800"></div>

            <div>
                <label class="fb-label" asp-for="Identifier"></label>
                <input class="fb-input" asp-for="Identifier" autocomplete="username" placeholder="khach@example.local hoặc 0901234567" />
                <span class="text-xs text-red-700" asp-validation-for="Identifier"></span>
            </div>

            <div>
                <label class="fb-label" asp-for="Password"></label>
                <input class="fb-input" asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span class="text-xs text-red-700" asp-validation-for="Password"></span>
            </div>

            <div class="flex items-center justify-between text-sm">
                <label class="inline-flex items-center gap-2 text-ink">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-line text-brand-700" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
                <a class="font-medium text-brand-800 hover:underline" href="/booking/lookup">Tra cứu mã nhanh</a>
            </div>

            <button class="fb-button fb-button-primary w-full justify-center" type="submit">Đăng nhập</button>
        </form>

        <div class="mt-6 border-t border-line pt-4 text-center text-sm text-muted">
            Chưa có tài khoản?
            <a class="font-semibold text-brand-800 hover:underline" href="/account/register">Đăng ký ngay</a>
        </div>
    </div>
</section>

<partial name="_ValidationScriptsPartial" />
