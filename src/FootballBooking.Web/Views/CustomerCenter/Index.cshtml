@model CustomerAccountHomeViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Tổng quan tài khoản";
    ViewData["AccountSection"] = "overview";
}
@functions {
    private static string FormatMinute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
}
@if (TempData["SuccessMessage"] is string success)
{
    <div class="rounded-xl border border-brand-100 bg-brand-50 px-4 py-3 text-sm text-brand-800" role="status">@success</div>
}
<section class="fb-account-section">
    <p class="fb-account-kicker">Xin chào</p>
    <h2 class="mt-2 text-2xl font-semibold text-ink">@Model.FullName</h2>
    <p class="mt-2 text-sm text-muted">Theo dõi lịch sân và khoản thanh toán trong một không gian gọn gàng.</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <a href="/account/bookings" class="rounded-xl border border-brand-100 bg-brand-50 p-4 hover:border-brand-700">
            <span class="block text-xs font-semibold text-brand-800">Đang xử lý / sắp diễn ra</span>
            <strong class="mt-2 block text-3xl font-semibold text-brand-900">@Model.UpcomingCount</strong>
        </a>
        <a href="/account/bookings" class="rounded-xl border border-line bg-slate-50 p-4 hover:border-brand-700">
            <span class="block text-xs font-semibold text-muted">Đã hoàn thành</span>
            <strong class="mt-2 block text-3xl font-semibold text-ink">@Model.CompletedCount</strong>
        </a>
        <a href="/account/bookings" class="rounded-xl border border-line bg-slate-50 p-4 hover:border-brand-700">
            <span class="block text-xs font-semibold text-muted">Đã hủy / hết hạn</span>
            <strong class="mt-2 block text-3xl font-semibold text-ink">@Model.OtherCount</strong>
        </a>
    </div>
    <p class="mt-3 text-xs text-muted">Số liệu tóm tắt từ các booking gần đây của tài khoản.</p>
</section>
<section class="fb-account-section">
    <div class="flex items-center justify-between gap-3">
        <div><p class="fb-account-kicker">Lịch đặt của tôi</p><h2 class="fb-account-section-title mt-1">Lượt đặt gần đây</h2></div>
        <a class="text-sm font-semibold text-brand-800 hover:underline" href="/account/bookings">Xem tất cả</a>
    </div>
    @if (Model.RecentBookings.Count == 0)
    {
        <p class="mt-5 rounded-lg bg-slate-50 p-5 text-sm text-muted">Chưa có lịch đặt gắn với tài khoản. <a href="/booking" class="font-semibold text-brand-800 underline">Đặt sân ngay</a>.</p>
    }
    else
    {
        <div class="mt-4 divide-y divide-line">
            @foreach (var booking in Model.RecentBookings)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 py-4">
                    <div class="min-w-0"><div class="font-semibold text-ink">@booking.FieldName <span class="ml-2 text-xs font-normal text-muted">@booking.BookingCode</span></div>
                        <p class="mt-1 text-sm text-muted">@booking.BookingDate.ToString("dd/MM/yyyy") · @FormatMinute(booking.StartMinute) – @FormatMinute(booking.EndMinute) · @BookingLabels.Status(booking.Status)</p></div>
                    <a class="fb-button fb-button-secondary" href="/booking/success/@booking.BookingCode">Chi tiết</a>
                </div>
            }
        </div>
    }
</section>
<section class="grid gap-4 sm:grid-cols-2">
    <a href="/account/profile" class="fb-account-section transition hover:border-brand-700"><h3 class="font-semibold text-ink">Hồ sơ cá nhân</h3><p class="mt-2 text-sm text-muted">Tên hiển thị, email và số điện thoại đã xác thực.</p><span class="mt-4 block text-sm font-semibold text-brand-800">Mở hồ sơ →</span></a>
    <a href="/account/payments" class="fb-account-section transition hover:border-brand-700"><h3 class="font-semibold text-ink">Lịch sử thanh toán</h3><p class="mt-2 text-sm text-muted">Theo dõi số tiền đã ghi nhận và yêu cầu thanh toán.</p><span class="mt-4 block text-sm font-semibold text-brand-800">Xem giao dịch →</span></a>
</section>
