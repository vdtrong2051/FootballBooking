@model CustomerProfileEditViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["AccountSection"] = "profile";
}
<section class="fb-account-section">
    <p class="fb-account-kicker">Thông tin cá nhân</p>
    <h2 class="fb-account-section-title mt-1">Hồ sơ của bạn</h2>
    <p class="mt-2 text-sm text-muted">Thông tin xác thực được giữ riêng, không dùng số điện thoại để tự nhận booking của người khác.</p>
    @if (TempData["SuccessMessage"] is string message)
    {
        <p class="mt-4 rounded-lg border border-brand-100 bg-brand-50 p-3 text-sm text-brand-800" role="status">@message</p>
    }
    <form action="/account/profile" method="post" class="mt-6 max-w-xl space-y-5">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
        <div><label asp-for="FullName" class="fb-label"></label><input asp-for="FullName" class="fb-input" autocomplete="name" maxlength="120" /><span asp-validation-for="FullName" class="text-xs text-red-700"></span></div>
        <div><label class="fb-label" for="account-email">Email</label><input class="fb-input bg-slate-50" id="account-email" value="@Model.Email" readonly /><p class="mt-1 text-xs text-muted">Email hiện giữ nguyên cho đến khi có luồng xác nhận email mới. Không cập nhật email chưa xác thực.</p></div>
        <div><label class="fb-label" for="account-phone">Số điện thoại</label><input class="fb-input bg-slate-50" id="account-phone" value="@Model.PhoneNumber" readonly /><div class="mt-2 flex flex-wrap items-center gap-3"><span class="text-xs @(Model.PhoneConfirmed ? "text-brand-800" : "text-red-700")">@(Model.PhoneConfirmed ? "Đã xác thực số điện thoại" : "Chưa xác thực số điện thoại")</span><a class="text-xs font-semibold text-brand-800 underline" href="/account/change-phone">Đổi số điện thoại qua OTP</a></div></div>
        <div class="pt-1"><button type="submit" class="fb-button fb-button-primary">Lưu thay đổi</button></div>
    </form>
</section>
