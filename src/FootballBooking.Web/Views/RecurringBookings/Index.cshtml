@model IReadOnlyList<FootballBooking.Application.Bookings.RecurringSeriesSummaryDto>
@{
    ViewData["Title"] = "Lịch định kỳ của tôi";
}
<section class="fb-container py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold text-ink">Chuỗi đặt sân định kỳ</h1>
        <a class="fb-button fb-button-primary" href="/account/recurring/create">Tạo chuỗi mới</a>
    </div>
    <p class="mt-3 text-sm text-muted">Mỗi buổi là một booking riêng, có cọc và thời hạn giữ chỗ riêng. Không tự động thanh toán.</p>
    <div class="mt-5 space-y-3">
        @if (Model.Count == 0) { <p class="fb-card p-5 text-muted">Bạn chưa có chuỗi đặt sân định kỳ nào.</p> }
        @foreach (var series in Model)
        {
            <a class="fb-card block p-4" href="/account/recurring/@series.Id">
                <strong>Bắt đầu @series.FirstDate.ToString("dd/MM/yyyy")</strong>
                <span class="ml-2 text-sm text-muted">@series.SuccessCount/@series.TotalCount buổi tạo thành công (mục tiêu @series.Weeks tuần)</span>
            </a>
        }
    </div>
</section>
