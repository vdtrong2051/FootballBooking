@model FootballBooking.Web.ViewModels.Fields.FieldListPageViewModel
@{
    ViewData["Title"] = "Sân bóng";
}
<section class="border-b border-line bg-white">
    <div class="fb-container py-12 sm:py-16">
        <p class="fb4-kicker">Khám phá sân bóng</p>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-5"><div><h1 class="max-w-2xl text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Tìm sân phù hợp với đội của bạn</h1><p class="fb4-lead mt-3 max-w-2xl">Duyệt các sân đang mở đặt, xem tiện ích, bảng giá và chọn giờ trống.</p></div><a class="fb-button fb-button-primary" href="/booking">Đặt sân ngay</a></div>
        <div class="mt-8 fb4-subnav" aria-label="Điều hướng nhanh"><a href="/fields" aria-current="page">Tất cả sân</a><a href="/services">Dịch vụ</a><a href="/promotions">Khuyến mãi</a></div>
    </div>
</section>
<section class="fb-container fb4-section">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3"><h2 class="text-lg font-bold text-ink">Sân đang nhận đặt</h2><p class="text-sm text-muted">@Model.Fields.Count sân</p></div>
    @if (Model.Fields.Count == 0) { <div class="fb4-surface p-8"><partial name="Partials/_EmptyState" model='new EmptyStateViewModel("Chưa có sân đang hoạt động", "Chủ sân chưa mở sân nào cho website công khai.")' /></div> }
    else { <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">@foreach (var field in Model.Fields) { <partial name="Partials/_PublicFieldCard" model="field" /> }</div> }
</section>
