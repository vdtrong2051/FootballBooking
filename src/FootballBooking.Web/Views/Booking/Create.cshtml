@model BookingCreateViewModel
@{
    ViewData["Title"] = "Đặt sân";
    var paymentOptions = new (PaymentMethod Method, string Title, string Subtitle, string Badge)[]
    {
        (PaymentMethod.VietQr, "VietQR", "Quét mã QR ngân hàng tự động điền nội dung", "Phổ biến"),
        (PaymentMethod.MoMo, "MoMo", "Thanh toán nhanh qua ví điện tử MoMo", "Ví điện tử"),
        (PaymentMethod.ZaloPay, "ZaloPay", "Quét QR hoặc mở ứng dụng ZaloPay", "Ví điện tử"),
        (PaymentMethod.BankTransfer, "Chuyển khoản", "Chuyển khoản thủ công qua số tài khoản", "Ngân hàng"),
        (PaymentMethod.Card, "Thẻ ngân hàng", "Thanh toán thẻ ATM / Visa / Mastercard tại quầy", "Thẻ POS"),
        (PaymentMethod.Cash, "Tiền mặt", "Thanh toán trực tiếp tại sân khi check-in", "Tại sân")
    };
}
@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
    private static string FormatMinute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
}

<section class="border-b border-line bg-white">
    <div class="fb-container py-8">
        <p class="text-sm font-semibold uppercase text-brand-800">Đặt sân trực tuyến</p>
        <h1 class="mt-2 text-3xl font-semibold text-ink">Chọn sân, khung giờ và phương thức thanh toán</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span>Bạn đang đặt sân bằng tài khoản cá nhân. Thông tin liên hệ đã được điền sẵn và lịch đặt sẽ lưu trong mục <a class="font-semibold text-brand-800 underline" href="/account/bookings">Lịch đặt của tôi</a>.</span>
            }
            else
            {
                <span>Khách có thể đặt sân nhanh không cần tài khoản, hoặc <a class="font-semibold text-brand-800 underline" href="/account/login?returnUrl=/booking">đăng nhập</a> để lưu lịch sử đặt sân.</span>
            }
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
            <div class="rounded-ui border border-brand-700 bg-brand-50 p-3">
                <p class="text-xs font-semibold uppercase text-brand-800">Bước 1</p>
                <p class="mt-1 text-sm font-semibold text-ink">Chọn sân &amp; khung giờ</p>
            </div>
            <div class="rounded-ui border border-brand-700 bg-brand-50 p-3">
                <p class="text-xs font-semibold uppercase text-brand-800">Bước 2</p>
                <p class="mt-1 text-sm font-semibold text-ink">Dịch vụ đi kèm &amp; thông tin khách</p>
            </div>
            <div class="rounded-ui border border-brand-700 bg-brand-50 p-3">
                <p class="text-xs font-semibold uppercase text-brand-800">Bước 3</p>
                <p class="mt-1 text-sm font-semibold text-ink">Chọn phương thức thanh toán</p>
            </div>
        </div>
    </div>
</section>

<section class="fb-container grid gap-5 py-8 lg:grid-cols-[1.2fr_0.8fr]">
    <form class="fb-card p-5" method="post" asp-action="Create">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="mb-4 rounded-ui border border-red-200 bg-red-50 p-3 text-sm text-red-800"></div>

        <h2 class="text-base font-semibold text-ink">1. Sân bóng và khung giờ</h2>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div>
                <label class="fb-label" asp-for="FieldId">Sân bóng</label>
                <select class="fb-input" asp-for="FieldId">
                    @foreach (var field in Model.Fields)
                    {
                        <option value="@field.Id">@field.Name - @field.FieldType</option>
                    }
                </select>
                <span class="text-xs text-red-700" asp-validation-for="FieldId"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="BookingDateText">Ngày đặt sân</label>
                <input class="fb-input" asp-for="BookingDateText" inputmode="numeric" placeholder="dd/MM/yyyy" />
                <span class="text-xs text-red-700" asp-validation-for="BookingDateText"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="StartMinute">Giờ bắt đầu</label>
                <select class="fb-input" asp-for="StartMinute">
                    @foreach (var slot in Model.Slots)
                    {
                        <option value="@slot.StartMinute" disabled="@(!slot.IsAvailable)">@slot.Label @(slot.IsAvailable ? "" : "- không trống")</option>
                    }
                </select>
            </div>
            <div>
                <label class="fb-label" asp-for="EndMinute">Giờ kết thúc</label>
                <select class="fb-input" asp-for="EndMinute">
                    @for (var minute = 420; minute <= 1380; minute += 30)
                    {
                        <option value="@minute">@FormatMinute(minute)</option>
                    }
                </select>
            </div>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <h2 class="text-base font-semibold text-ink">2. Dịch vụ đi kèm &amp; thông tin liên hệ</h2>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                    @for (var i = 0; i < Model.Services.Count; i++)
                    {
                        <div class="rounded-ui border border-line bg-white p-3">
                            <input type="hidden" asp-for="Services[i].ServiceId" />
                            <input type="hidden" asp-for="Services[i].Name" />
                            <input type="hidden" asp-for="Services[i].UnitName" />
                            <input type="hidden" asp-for="Services[i].UnitPrice" />
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="font-medium text-ink">@Model.Services[i].Name</p>
                                    <p class="mt-1 text-xs text-muted">@Model.Services[i].Description</p>
                                    <p class="mt-2 text-sm font-semibold text-brand-800">@FormatMoney(Model.Services[i].UnitPrice) / @Model.Services[i].UnitName</p>
                                </div>
                                <input class="fb-input w-20" asp-for="Services[i].Quantity" type="number" min="0" max="20" aria-label="Số lượng @Model.Services[i].Name" />
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="sm:col-span-2">
                <label class="fb-label" asp-for="PromotionCode"></label>
                <input class="fb-input" asp-for="PromotionCode" placeholder="ANPHU50" />
            </div>
            <div>
                <label class="fb-label" asp-for="CustomerName"></label>
                <input class="fb-input" asp-for="CustomerName" autocomplete="name" placeholder="Nguyễn Minh Tuấn" />
                <span class="text-xs text-red-700" asp-validation-for="CustomerName"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="CustomerPhone"></label>
                <input class="fb-input" asp-for="CustomerPhone" autocomplete="tel" placeholder="0901 234 567" />
                <span class="text-xs text-red-700" asp-validation-for="CustomerPhone"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="CustomerEmail"></label>
                <input class="fb-input" asp-for="CustomerEmail" autocomplete="email" placeholder="khach@example.local" />
                <span class="text-xs text-red-700" asp-validation-for="CustomerEmail"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="Note"></label>
                <input class="fb-input" asp-for="Note" placeholder="Ghi chú cho nhân viên nếu có" />
            </div>
        </div>

        <div class="mt-6">
            <h2 class="text-base font-semibold text-ink">3. Phương thức thanh toán</h2>
            <p class="mt-1 text-xs text-muted">Chọn phương thức bạn muốn sử dụng để nhận hướng dẫn thanh toán / mã QR ngay sau khi đặt sân.</p>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
                @foreach (var option in paymentOptions)
                {
                    <label class="flex cursor-pointer items-start gap-3 rounded-ui border border-line bg-white p-3 hover:border-brand-700">
                        <input type="radio" asp-for="PreferredPaymentMethod" value="@option.Method" class="mt-1 text-brand-700 focus:ring-brand-700" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-sm font-semibold text-ink">@option.Title</span>
                                <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700">@option.Badge</span>
                            </div>
                            <p class="mt-1 text-xs text-muted">@option.Subtitle</p>
                        </div>
                    </label>
                }
            </div>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-muted">Sau khi gửi, hệ thống giữ chỗ trong 10 phút để hoàn tất thanh toán hoặc xác nhận.</p>
            <button class="fb-button fb-button-primary" type="submit">
                <partial name="Partials/_HeroIcon" model='new HeroIconViewModel("check-circle")' />
                <span>Xác nhận đặt sân</span>
            </button>
        </div>
    </form>

    <aside class="space-y-4">
        <section class="fb-card p-4">
            <h2 class="font-semibold text-ink">Tạm tính</h2>
            @if (Model.Quote is null)
            {
                <p class="mt-3 text-sm text-muted">Chọn sân, ngày và khung giờ để xem giá.</p>
            }
            else
            {
                <div class="mt-3 space-y-3 text-sm">
                    @foreach (var segment in Model.Quote.Segments)
                    {
                        <div class="flex justify-between gap-3">
                            <span class="text-muted">@FormatMinute(segment.StartMinute) - @FormatMinute(segment.EndMinute)</span>
                            <span class="font-medium text-ink">@FormatMoney(segment.Amount)</span>
                        </div>
                    }
                    <div class="border-t border-line pt-3 flex justify-between gap-3 text-base font-semibold">
                        <span>Tổng tiền sân</span>
                        <span>@FormatMoney(Model.Quote.CourtAmount)</span>
                    </div>
                    <div class="flex justify-between gap-3">
                        <span class="text-muted">Dịch vụ đã chọn</span>
                        <span class="font-medium text-ink">@FormatMoney(Model.ServiceAmount)</span>
                    </div>
                    <div class="border-t border-line pt-3 flex justify-between gap-3 text-base font-semibold text-brand-900">
                        <span>Tạm tính trước khuyến mãi</span>
                        <span>@FormatMoney(Model.EstimatedTotal)</span>
                    </div>
                </div>
            }
        </section>

        <section class="fb-card p-4">
            <h2 class="font-semibold text-ink">Khung giờ trống</h2>
            @if (Model.Slots.Count == 0)
            {
                <partial name="Partials/_EmptyState" model='new EmptyStateViewModel("Chưa có khung giờ", "Vui lòng chọn sân và ngày khác để xem lịch trống.", IconName: "calendar")' />
            }
            else
            {
                <div class="mt-3 grid grid-cols-2 gap-2">
                    @foreach (var slot in Model.Slots.Take(12))
                    {
                        <span class="rounded-ui border px-3 py-2 text-center text-xs font-medium @(slot.IsAvailable ? "border-green-200 bg-green-50 text-green-800" : "border-slate-200 bg-slate-50 text-muted")">@slot.Label</span>
                    }
                </div>
            }
        </section>
    </aside>
</section>

<partial name="_ValidationScriptsPartial" />
