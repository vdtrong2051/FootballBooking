@model BookingCreateViewModel
@{
    ViewData["Title"] = "Đặt sân";
    var paymentOptions = new (PaymentMethod Method, string Title, string Subtitle)[]
    {
        (PaymentMethod.VietQr, "VietQR", "Dự kiến thanh toán qua ngân hàng"),
        (PaymentMethod.MoMo, "MoMo", "Dự kiến thanh toán qua ví MoMo"),
        (PaymentMethod.ZaloPay, "ZaloPay", "Dự kiến thanh toán qua ví ZaloPay"),
        (PaymentMethod.BankTransfer, "Chuyển khoản", "Chuyển khoản ngân hàng"),
        (PaymentMethod.Card, "Thẻ ngân hàng", "Thanh toán tại quầy"),
        (PaymentMethod.Cash, "Tiền mặt", "Thanh toán tại sân")
    };
    var preview = Model.QuotePreview;
    var previewValid = preview?.IsValid == true;
}
@functions {
    private static string Money(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
    private static string Minute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
}
<section class="border-b border-line bg-white">
    <div class="fb-container py-8">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-800">Đặt sân trực tuyến</p>
        <h1 class="mt-2 text-3xl font-semibold text-ink">Chọn sân, giờ chơi và xem giá tức thì</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">
            Khung giờ và báo giá được kiểm tra lại trước khi giữ sân. Chỗ chỉ được giữ sau khi xác nhận đặt sân thành công.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-3" aria-label="Các bước đặt sân">
            <div class="rounded-ui border border-brand-200 bg-brand-50 px-4 py-3"><span class="text-xs font-semibold text-brand-800">01</span><p class="mt-1 text-sm font-semibold text-ink">Sân, ngày, thời lượng</p></div>
            <div class="rounded-ui border border-line bg-white px-4 py-3"><span class="text-xs font-semibold text-muted">02</span><p class="mt-1 text-sm font-semibold text-ink">Dịch vụ và thông tin</p></div>
            <div class="rounded-ui border border-line bg-white px-4 py-3"><span class="text-xs font-semibold text-muted">03</span><p class="mt-1 text-sm font-semibold text-ink">Xác nhận &amp; giữ sân</p></div>
        </div>
    </div>
</section>

<section class="fb-container grid min-w-0 gap-5 py-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(290px,0.65fr)] lg:items-start">
    <form id="gd1-booking-form" class="fb-card min-w-0 p-4 sm:p-6" method="post" asp-action="Create">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="mb-4 rounded-ui border border-red-200 bg-red-50 p-3 text-sm text-red-800"></div>
        <h2 class="text-lg font-semibold text-ink">1. Chọn sân và giờ chơi</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
                <label class="fb-label" asp-for="FieldId">Sân bóng</label>
                <select class="fb-input w-full" asp-for="FieldId">
                    @foreach (var field in Model.Fields)
                    {
                        <option value="@field.Id">@field.Name · @field.FieldType</option>
                    }
                </select>
                <span class="text-xs text-red-700" asp-validation-for="FieldId"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="BookingDateText">Ngày chơi (dd/MM/yyyy)</label>
                <input class="fb-input w-full" asp-for="BookingDateText" inputmode="numeric" autocomplete="off" placeholder="dd/MM/yyyy" />
                <span class="text-xs text-red-700" asp-validation-for="BookingDateText"></span>
            </div>
            <div class="sm:col-span-2">
                <label class="fb-label" asp-for="DurationMinutes">Thời lượng</label>
                <select class="fb-input w-full sm:max-w-xs" asp-for="DurationMinutes">
                    <option value="60">60 phút</option>
                    <option value="90">90 phút</option>
                    <option value="120">120 phút</option>
                </select>
                <span class="text-xs text-red-700" asp-validation-for="DurationMinutes"></span>
            </div>
        </div>

        <fieldset class="mt-6" aria-describedby="gd1-slot-status">
            <legend class="text-sm font-semibold text-ink">Khung giờ bắt đầu</legend>
            <p class="mt-1 text-xs text-muted">Chọn một khung giờ. Giờ kết thúc sẽ tự tính theo thời lượng ở trên.</p>
            <p id="gd1-slot-status" class="mt-3 text-sm text-muted" role="status" aria-live="polite">
                @(Model.Slots.Count == 0 ? "Không có giờ khả dụng cho lựa chọn này." : "Các khung giờ màu xanh có thể chọn; khung giờ xám đã kín hoặc chưa hợp lệ.")
            </p>
            <div id="gd1-slots" class="mt-3 grid max-h-80 grid-cols-2 gap-2 overflow-y-auto sm:grid-cols-3" aria-label="Danh sách giờ bắt đầu">
                @foreach (var slot in Model.Slots)
                {
                    <label class="flex min-w-0 items-center gap-2 rounded-ui border px-3 py-2 text-xs font-medium @(slot.IsAvailable ? "cursor-pointer border-green-200 bg-green-50 text-green-900" : "cursor-not-allowed border-slate-200 bg-slate-50 text-muted")">
                        <input type="radio" name="StartMinute" value="@slot.StartMinute" checked="@(Model.StartMinute == slot.StartMinute && slot.IsAvailable)" disabled="@(!slot.IsAvailable)" class="h-4 w-4 shrink-0 accent-green-700" aria-label="@slot.Label @(slot.IsAvailable ? "" : slot.UnavailableReason)" />
                        <span>@Minute(slot.StartMinute)</span>
                        <span class="sr-only">đến @Minute(slot.EndMinute)</span>
                    </label>
                }
            </div>
            <span class="mt-2 block text-xs text-red-700" asp-validation-for="StartMinute"></span>
        </fieldset>

        <div class="mt-7 border-t border-line pt-6">
            <h2 class="text-lg font-semibold text-ink">2. Dịch vụ và thông tin liên hệ</h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                @for (var i = 0; i < Model.Services.Count; i++)
                {
                    <div class="rounded-ui border border-line p-3">
                        <input type="hidden" asp-for="Services[i].ServiceId" />
                        <input type="hidden" asp-for="Services[i].Name" />
                        <input type="hidden" asp-for="Services[i].UnitName" />
                        <input type="hidden" asp-for="Services[i].UnitPrice" />
                        <div class="flex min-w-0 items-start justify-between gap-2">
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-ink">@Model.Services[i].Name</p>
                                <p class="mt-1 text-xs text-muted">@Model.Services[i].Description</p>
                                <p class="mt-2 text-xs font-semibold text-brand-800">@Money(Model.Services[i].UnitPrice) / @Model.Services[i].UnitName</p>
                            </div>
                            <input class="fb-input w-20 shrink-0" asp-for="Services[i].Quantity" type="number" min="0" max="20" aria-label="Số lượng @Model.Services[i].Name" />
                        </div>
                        <span asp-validation-for="Services[i].Quantity" class="text-xs text-red-700"></span>
                    </div>
                }
                <div class="sm:col-span-2">
                    <label class="fb-label" asp-for="PromotionCode"></label>
                    <input class="fb-input w-full" asp-for="PromotionCode" placeholder="Nhập mã nếu có" />
                </div>
                <div>
                    <label class="fb-label" asp-for="CustomerName"></label>
                    <input class="fb-input w-full" asp-for="CustomerName" autocomplete="name" />
                    <span asp-validation-for="CustomerName" class="text-xs text-red-700"></span>
                </div>
                <div>
                    <label class="fb-label" asp-for="CustomerPhone"></label>
                    <input class="fb-input w-full" asp-for="CustomerPhone" autocomplete="tel" />
                    <span asp-validation-for="CustomerPhone" class="text-xs text-red-700"></span>
                </div>
                <div>
                    <label class="fb-label" asp-for="CustomerEmail"></label>
                    <input class="fb-input w-full" asp-for="CustomerEmail" autocomplete="email" />
                    <span asp-validation-for="CustomerEmail" class="text-xs text-red-700"></span>
                </div>
                <div>
                    <label class="fb-label" asp-for="Note"></label>
                    <input class="fb-input w-full" asp-for="Note" placeholder="Yêu cầu khác (nếu có)" />
                </div>
            </div>
        </div>

        <div class="mt-7 border-t border-line pt-6">
            <h2 class="text-lg font-semibold text-ink">3. Phương thức thanh toán dự kiến</h2>
            <p class="mt-1 text-xs text-muted">Đây chỉ là lựa chọn để ghi nhận nhu cầu. Tích hợp xác nhận giao dịch và QR được triển khai ở GĐ2.</p>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
                @foreach (var option in paymentOptions)
                {
                    <label class="flex cursor-pointer items-start gap-2 rounded-ui border border-line p-3 hover:border-brand-700">
                        <input type="radio" asp-for="PreferredPaymentMethod" value="@option.Method" class="mt-1 shrink-0 accent-green-700" />
                        <span class="min-w-0"><span class="block text-sm font-semibold text-ink">@option.Title</span><span class="block text-xs text-muted">@option.Subtitle</span></span>
                    </label>
                }
            </div>
        </div>

        <div class="mt-6 border-t border-line pt-5">
            <div class="mb-4 flex items-center justify-between gap-3 rounded-ui border border-brand-200 bg-brand-50 p-3 text-sm lg:hidden" aria-live="polite">
                <span class="font-medium text-brand-900">Tổng tiền dự kiến</span>
                <strong id="gd1-mobile-total" class="text-base font-semibold text-brand-900">@Money(previewValid ? preview!.TotalAmount : 0)</strong>
            </div>
            <p class="mb-4 text-sm text-muted">Hệ thống giữ sân trong 10 phút sau khi xác nhận thành công. Chọn giờ không tự giữ sân.</p>
            <button id="gd1-submit" class="fb-button fb-button-primary w-full justify-center sm:w-auto" type="submit" disabled="@(!previewValid)">
                Xác nhận đặt sân
            </button>
        </div>
    </form>

    <aside class="min-w-0 lg:sticky lg:top-24" aria-label="Tóm tắt đặt sân">
        <section class="fb-card p-4 sm:p-5">
            <h2 class="text-lg font-semibold text-ink">Tóm tắt và báo giá</h2>
            <div class="mt-4 space-y-2 text-sm">
                <div class="flex justify-between gap-3"><span class="text-muted">Sân</span><strong id="gd1-summary-field" class="text-right text-ink">@(Model.Fields.FirstOrDefault(f => f.Id == Model.FieldId)?.Name ?? "Chưa chọn")</strong></div>
                <div class="flex justify-between gap-3"><span class="text-muted">Ngày</span><strong id="gd1-summary-date" class="text-right text-ink">@Model.BookingDateText</strong></div>
                <div class="flex justify-between gap-3"><span class="text-muted">Khung giờ</span><strong id="gd1-summary-time" class="text-right text-ink">@(Model.StartMinute >= 0 ? $"{Minute(Model.StartMinute)} – {Minute(Model.EndMinute)}" : "Chưa chọn")</strong></div>
            </div>
            <p id="gd1-quote-status" class="mt-4 text-sm text-muted" role="status" aria-live="polite">@(previewValid ? "Giá dự kiến theo lựa chọn hiện tại." : "Chọn giờ trống để xem báo giá.")</p>
            <ul id="gd1-quote-errors" class="mt-2 space-y-1 text-xs text-red-700" aria-live="polite">
                @foreach (var error in preview?.Errors ?? [])
                {
                    <li>@error</li>
                }
            </ul>
            <div class="mt-4 border-t border-line pt-4 text-sm">
                <div id="gd1-price-segments" class="space-y-1 text-xs text-muted">
                    @foreach (var segment in preview?.Segments ?? [])
                    {
                        <div class="flex justify-between gap-2"><span>@Minute(segment.StartMinute)–@Minute(segment.EndMinute) · @segment.RuleName</span><span>@Money(segment.Amount)</span></div>
                    }
                </div>
                <div class="mt-3 flex justify-between gap-3"><span>Tiền sân</span><strong id="gd1-price-court">@Money(preview?.CourtAmount ?? 0)</strong></div>
                <div class="mt-2 flex justify-between gap-3"><span>Dịch vụ</span><strong id="gd1-price-services">@Money(preview?.ServiceAmount ?? 0)</strong></div>
                <div class="mt-2 flex justify-between gap-3"><span>Khuyến mãi</span><strong id="gd1-price-discount">-@Money(preview?.DiscountAmount ?? 0)</strong></div>
                <div class="mt-4 flex justify-between gap-3 border-t border-line pt-4 text-base font-semibold text-brand-900"><span>Tổng tiền</span><strong id="gd1-price-total">@Money(previewValid ? preview!.TotalAmount : 0)</strong></div>
                <p class="mt-3 text-xs leading-5 text-muted">Giá trên chỉ là báo giá tức thời. Số tiền cuối cùng do máy chủ xác nhận khi đặt.</p>
            </div>
        </section>
    </aside>
</section>

<script src="~/js/booking-gd1.js" asp-append-version="true" defer></script>
<partial name="_ValidationScriptsPartial" />
