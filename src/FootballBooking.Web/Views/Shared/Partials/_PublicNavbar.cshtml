@using FootballBooking.Application.Common.Security
<header class="border-b border-line bg-white">
    <nav class="fb-container flex min-h-16 items-center justify-between gap-4" aria-label="Điều hướng công khai">
        <partial name="Partials/_BrandLogo" />

        <button type="button" class="fb-button fb-button-secondary px-3 lg:hidden" aria-label="Mở menu" data-hs-overlay="#public-mobile-menu">
            <partial name="Partials/_HeroIcon" model='new HeroIconViewModel("menu")' />
        </button>

        <div class="hidden items-center gap-6 lg:flex">
            <a class="text-sm font-medium text-ink hover:text-brand-800" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a class="text-sm font-medium text-ink hover:text-brand-800" href="/fields">Sân bóng</a>
            <a class="text-sm font-medium text-ink hover:text-brand-800" href="/services">Dịch vụ</a>
            <a class="text-sm font-medium text-ink hover:text-brand-800" href="/promotions">Khuyến mãi</a>
            <a class="text-sm font-medium text-ink hover:text-brand-800" href="/booking/lookup">Tra cứu đặt sân</a>
            <a class="text-sm font-medium text-ink hover:text-brand-800" href="/contact">Liên hệ</a>
        </div>

        <div class="hidden items-center gap-2 lg:flex">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-xs font-medium text-muted">@User.Identity.Name</span>
                @if (User.IsInRole(ApplicationRoles.Owner) || User.IsInRole(ApplicationRoles.Staff))
                {
                    <a class="fb-button fb-button-secondary" href="/admin/dashboard">Vào trang Quản trị</a>
                }
                <a class="fb-button fb-button-secondary" href="/account/bookings">Lịch đặt của tôi</a>
                <form method="post" action="/account/logout" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="fb-button fb-button-secondary">Đăng xuất</button>
                </form>
            }
            else
            {
                <a class="fb-button fb-button-secondary" href="/account/login">Đăng nhập</a>
                <a class="text-sm font-medium text-brand-800 hover:underline px-2" href="/account/register">Đăng ký</a>
            }
            <a class="fb-button fb-button-primary" href="/booking">Đặt sân ngay</a>
        </div>
    </nav>
</header>

<div id="public-mobile-menu" class="hs-overlay pointer-events-none fixed start-0 top-0 z-80 hidden size-full overflow-hidden lg:hidden" role="dialog" tabindex="-1" aria-label="Menu công khai">
    <div class="hs-overlay-open:translate-x-0 pointer-events-auto h-full w-80 max-w-[88vw] -translate-x-full bg-white shadow-sm transition-transform">
        <div class="flex min-h-16 items-center justify-between border-b border-line px-4">
            <partial name="Partials/_BrandLogo" />
            <button type="button" class="fb-button fb-button-secondary px-3" aria-label="Đóng menu" data-hs-overlay="#public-mobile-menu">
                <partial name="Partials/_HeroIcon" model='new HeroIconViewModel("x-mark")' />
            </button>
        </div>
        <div class="grid gap-1 p-4 text-sm font-medium">
            <a class="rounded-ui px-3 py-2 hover:bg-slate-50" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/fields">Sân bóng</a>
            <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/services">Dịch vụ</a>
            <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/promotions">Khuyến mãi</a>
            <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/booking/lookup">Tra cứu đặt sân</a>
            <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/contact">Liên hệ</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole(ApplicationRoles.Owner) || User.IsInRole(ApplicationRoles.Staff))
                {
                    <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/admin/dashboard">Vào trang Quản trị</a>
                }
                <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/account/bookings">Lịch đặt của tôi</a>
            }
            else
            {
                <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/account/login">Đăng nhập</a>
                <a class="rounded-ui px-3 py-2 hover:bg-slate-50" href="/account/register">Đăng ký</a>
            }
            <div class="mt-3 grid gap-2">
                <a class="fb-button fb-button-primary" href="/booking">Đặt sân ngay</a>
            </div>
        </div>
    </div>
</div>
