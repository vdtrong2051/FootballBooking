{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=football_booking;User=footballbooking;Password=footballbooking;SslMode=Preferred"
  },
  "Database": {
    "ServerVersion": "8.0.46",
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "Business": {
    "TimeZoneId": "Asia/Ho_Chi_Minh"
  },
  "BookingPolicy": {
    "PublicCancellationHoursBeforeStart": 12,
    "LateCancellationFeePercent": 0,
    "NoShowGraceMinutes": 15,
    "DepositPercent": 30,
    "MinimumDepositAmount": 50000,
    "CheckInEarlyMinutes": 30,
    "CheckInLateMinutes": 15,
    "MaxLateStartMinutes": 30,
    "MaximumExtensionMinutes": 120,
    "OvertimeGraceMinutes": 5,
    "OvertimeBillingStepMinutes": 15,
    "MaxAutoOvertimeMinutes": 180
  }
}
